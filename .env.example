# Environment Configuration Template for Campus Hub
# Copy to .env for local overrides

# Database Configuration
DB_NAME=campus_hub
DB_USERNAME=root
DB_PASSWORD=root123
DB_PORT=3306

# Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Frontend Configuration
FRONTEND_PORT=80

# CORS Configuration (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173
